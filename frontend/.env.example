NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# From CDK outputs
COGNITO_CLIENT_ID=<LunarisUserPoolClientId>
COGNITO_CLIENT_SECRET=<from step 2>
COGNITO_ISSUER=<LunarisCognitoIssuer>
NEXT_PUBLIC_COGNITO_REGION=<e.g. us-west-2>

# Generated secret (NextAuth v5)
AUTH_SECRET=<from openssl command>

# Local development
AUTH_URL=https://localhost:3000

# From CDK outputs
NEXT_PUBLIC_API_GATEWAY_URL=<your-api-gateway-url>
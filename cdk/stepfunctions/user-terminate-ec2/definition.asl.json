{
    "Comment": "UserTerminateEC2 Step Function",
    "StartAt": "CheckRunningStreams",
    "States": {
        "CheckRunningStreams": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${CheckRunningStreamsArn}",
                "Payload.$": "$"
            },
            "ResultPath": "$.checkRunningStreamsResult",
            "Next": "CheckIfValidStream",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "CheckIfValidStream": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.checkRunningStreamsResult.Payload.valid",
                    "BooleanEquals": true,
                    "Next": "CheckRunningInstances"
                }
            ],
            "Default": "InvalidStreamError"
        },
        "CheckRunningInstances": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "CheckRunningInstancesArn",
                "Payload.$": "$.checkRunningStreamsResult.Payload.instanceId"
            },
            "ResultPath": "$.checkRunningInstancesResult",
            "Next": "CheckValidInstance",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["Missing required fields: instanceId, status"],
                    "Next": "HandleMissingFields"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "CheckValidInstance": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.checkRunningInstancesResult.Payload.valid",
                    "BooleanEquals": true,
                    "Next": "StopDCV"
                }
            ],
            "Default": "InvalidInstanceError"
        },
        "StopDCV": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${StopDcvInstanceArn",
                "Payload": {
                    "userId.$": "$.userId",
                    "instanceId.$": "$.checkRunningStreamsResult.Payload.instanceId",
                    "instanceArn.$": "$.checkRunningStreamsResult.Payload.instanceArn"
                }
            },
            "ResultPath": "stopDcvResult",
            "Next": "StopEC2",
            "Catch": [
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleFailedDcvStop"
                }
            ]
        },
        "StopEC2": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${StopEC2Arn}",
                "Payload": {
                    "userId.$": "$.userId",
                    "instanceId.$": "$.checkRunningStreamsResult.Payload.instanceId"
                }
            },
            "ResultPath": "$.stopResult",
            "Next": "UpdateRunningStreams",
            "Catch": [
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleFailedStop"
                },
                {
                    "ErrorEquals": ["MissingLambdaRegionEnv", "InvalidStatus"],
                    "Next": "HandleFailedStop"
                }
            ]
        },
        "UpdateRunningStreams": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${UpdateRunningStreamsArn}",
                "Payload": {
                    "userId.$": "$.userId",
                    "instanceArn.$": "$.checkRunningStreamsResult.Payload.instanceArn"
                }
            },
            "ResultPath": "$.updateResult",
            "Next": "UpdateRunningInstances",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "UpdateRunningInstances": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${UpdateRunningInstancesArn}",
                "Payload": {
                    "instanceId.$": "$.checkRunningStreamsResult.Payload.instanceId",
                    "status.$": "$.stopEC2Result.Payload.status"
                }
            },
            "ResultPath": "$.updateResult",
            "Next": "Success",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "InvalidStreamError": {
            "Type": "Fail",
            "Cause": "No valid running stream found for user",
            "Error": "InvalidStreamError"
        },
        "InvalidInstanceError": {
            "Type": "Fail",
            "Cause": "No valid running instance found for user",
            "Error": "InvalidInstanceError"
        },
        "HandleMissingTableName": {
            "Type": "Fail",
            "Cause": "RUNNING_STREAMS_TABLE_NAME environment variable was not set",
            "Error": "MissingTableNameEnv"
        },
        "HandleDatabaseError": {
            "Type": "Fail",
            "Cause": "Error occurred while accessing the running streams database",
            "Error": "DatabaseError"
        },
        "HandleFailedStop": {
            "Type": "Fail",
            "Cause": "Failed to stop EC2 instance",
            "Error": "StopFailedError"
        },
        "HandleFailedDcvStop": {
            "Type": "Fail",
            "Cause": "Failed to stop Dcv session",
            "Error": "DcvStopFailedError"
        },
        "HandleMissingFields": {
          "Type": "Fail",
          "Cause": "Missing fields in input",
          "Error": "MissingFieldsError"
        },
        "Success": {
            "Type": "Succeed"
        }
    }
}

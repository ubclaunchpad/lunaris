{
    "Comment": "UserDeployEC2 Step Function",
    "StartAt": "CheckRunningStreams",
    "States": {
        "CheckRunningStreams": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${CheckRunningStreamsArn}",
                "Payload.$": "$"
            },
            "ResultPath": "$.checkRunningStreamsResult",
            "Next": "CheckIfValidStream",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "CheckIfValidStream": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.checkRunningStreamsResult.Payload.streamsRunning",
                    "BooleanEquals": false,
                    "Next": "CheckRunningInstances"
                }
            ],
            "Default": "HandleStreamsRunningError"
        },
        "CheckRunningInstances": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${CheckRunningInstancesArn}",
                "Payload.$": "$"
            },
            "ResultPath": "$.checkRunningInstancesResult",
            "Next": "CheckIfInstanceExists",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "CheckIfInstanceExists": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.checkRunningInstancesResult.Payload.status",
                    "StringEquals": "stopped",
                    "Next": "ResumeDeployInstance"
                },
                {
                    "Variable": "$.checkRunningInstancesResult.Payload.status",
                    "StringEquals": "terminated",
                    "Next": "DeployEC2"
                }
            ],
            "Default": "HandleInstancesRunningError"
        },
        "ResumeDeployInstance": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${ResumeDeployInstanceArn}",
                "Payload": {
                    "instanceId.$": "$.checkRunningInstancesResult.Payload.instanceId"
                }
            },
            "ResultPath": "$.resumeDeployResult",
            "Next": "WaitForResumeInstanceReady",
            "Catch": [
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleFailedDeployment"
                }
            ]
        },
        "WaitForResumeInstanceReady": {
            "Type": "Wait",
            "Seconds": 60,
            "Comment": "Wait for resumed EC2 instance to be ready for SSM commands",
            "Next": "GetDcvConfig"
        },
        "GetDcvConfig": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${GetDcvConfigArn}",
                "Payload": {
                    "instanceArn.$": "$.resumeDeployResult.Payload.instanceArn"
                }
            },
            "ResultPath": "$.dcvConfig",
            "Next": "MergeResumeData",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "Next": "HandleMissingTableName"
                },
                {
                    "ErrorEquals": ["StreamNotFound", "States.TaskFailed"],
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "MergeResumeData": {
            "Type": "Pass",
            "Comment": "Merge resume path data to match deploy path structure",
            "Parameters": {
                "userId.$": "$.userId",
                "deployResult": {
                    "Payload": {
                        "instanceId.$": "$.resumeDeployResult.Payload.instanceId",
                        "instanceArn.$": "$.resumeDeployResult.Payload.instanceArn",
                        "creationTime.$": "$.resumeDeployResult.Payload.creationTime",
                        "dcvIp.$": "$.dcvConfig.Payload.dcvIp",
                        "dcvPort.$": "$.dcvConfig.Payload.dcvPort",
                        "dcvUser.$": "$.dcvConfig.Payload.dcvUser",
                        "dcvPassword.$": "$.dcvConfig.Payload.dcvPassword"
                    }
                }
            },
            "ResultPath": "$",
            "Next": "StartDcvInstance"
        },
        "StartDcvInstance": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${StartDcvInstanceArn}",
                "Payload": {
                    "instanceId.$": "$.deployResult.Payload.instanceId"
                }
            },
            "ResultPath": "$.startDcvResult",
            "Next": "PrepareUpdatePayload",
            "Retry": [
                {
                    "ErrorEquals": [
                        "InvalidInstanceId",
                        "InstanceNotReadyForSsm",
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 20,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "ResultPath": "$.startDcvError",
                    "Next": "HandleStartDcvError"
                }
            ]
        },
        "DeployEC2": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${DeployEC2Arn}",
                "Payload": {
                    "userId.$": "$.userId"
                }
            },
            "ResultPath": "$.deployResult",
            "Next": "CheckDeploymentSuccess",
            "Catch": [
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "Next": "HandleFailedDeployment"
                }
            ]
        },
        "CheckDeploymentSuccess": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.deployResult.Payload.success",
                    "BooleanEquals": true,
                    "Next": "WaitForInstanceReady"
                }
            ],
            "Default": "HandleDeploymentError"
        },
        "HandleDeploymentError": {
            "Type": "Fail",
            "Cause": "EC2 deployment failed",
            "Error": "DeploymentFailedError"
        },
        "WaitForInstanceReady": {
            "Type": "Wait",
            "Seconds": 60,
            "Comment": "Wait for EC2 instance to be fully ready for SSM commands",
            "Next": "ConfigureDcvInstance"
        },
        "ConfigureDcvInstance": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${ConfigureDcvInstanceArn}",
                "Payload": {
                    "instanceId.$": "$.deployResult.Payload.instanceId",
                    "dcvIp.$": "$.deployResult.Payload.dcvIp",
                    "dcvPassword.$": "$.deployResult.Payload.dcvPassword"
                }
            },
            "ResultPath": "$.configureResult",
            "Next": "PrepareUpdatePayload",
            "Retry": [
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "IntervalSeconds": 30,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "ResultPath": "$.configureError",
                    "Next": "UpdateRunningStreams"
                }
            ]
        },
        "PrepareUpdatePayload": {
            "Type": "Pass",
            "Comment": "Normalize data from both deploy and resume paths for UpdateRunningStreams",
            "Parameters": {
                "userId.$": "$.userId",
                "instanceId.$": "$.deployResult.Payload.instanceId",
                "instanceArn.$": "$.deployResult.Payload.instanceArn",
                "dcvIp.$": "$.deployResult.Payload.dcvIp",
                "dcvPort.$": "$.deployResult.Payload.dcvPort",
                "dcvUser.$": "$.deployResult.Payload.dcvUser",
                "dcvPassword.$": "$.deployResult.Payload.dcvPassword"
            },
            "ResultPath": "$.updatePayload",
            "Next": "UpdateRunningStreams"
        },
        "UpdateRunningStreams": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${UpdateRunningStreamsArn}",
                "Payload.$": "$.updatePayload"
            },
            "ResultPath": "$.updateResult",
            "Next": "UpdateRunningInstances",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "ResultPath": "$.error",
                    "Next": "RollbackInstance"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "ResultPath": "$.error",
                    "Next": "RollbackInstance"
                }
            ]
        },
        "UpdateRunningInstances": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${UpdateRunningInstancesArn}",
                "Payload": {
                    "userId.$": "$.userId",
                    "instanceId.$": "$.updatePayload.instanceId",
                    "instanceArn.$": "$.updatePayload.instanceArn",
                    "creationTime.$": "$.deployResult.Payload.creationTime"
                }
            },
            "ResultPath": "$.updateRunningInstanceResult",
            "Next": "Success",
            "Catch": [
                {
                    "ErrorEquals": ["MissingTableNameEnv"],
                    "ResultPath": "$.error",
                    "Next": "RollbackInstance"
                },
                {
                    "ErrorEquals": ["States.TaskFailed"],
                    "ResultPath": "$.error",
                    "Next": "RollbackInstance"
                }
            ]
        },
        "RollbackInstance": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${TerminateEC2Arn}",
                "Payload": {
                    "userId.$": "$.userId",
                    "instanceId.$": "$.deployResult.Payload.instanceId",
                    "instanceArn.$": "$.deployResult.Payload.instanceArn"
                }
            },
            "ResultPath": "$.rollbackResult",
            "Next": "HandleDatabaseError",
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "ResultPath": "$.rollbackError",
                    "Next": "HandleDatabaseError"
                }
            ]
        },
        "Success": {
            "Type": "Succeed"
        },
        "HandleMissingTableName": {
            "Type": "Fail",
            "Cause": "RUNNING_STREAMS_TABLE_NAME environment variable was not set",
            "Error": "MissingTableNameEnv"
        },
        "HandleDatabaseError": {
            "Type": "Fail",
            "Cause": "Error occurred while accessing the running streams database",
            "Error": "DatabaseError"
        },
        "HandleStreamsRunningError": {
            "Type": "Fail",
            "Cause": "Valid running stream found for user",
            "Error": "StreamsRunningError"
        },
        "HandleInstancesRunningError": {
            "Type": "Fail",
            "Cause": "Valid running instance found for user",
            "Error": "InstancesRunningError"
        },
        "HandleFailedDeployment": {
            "Type": "Fail",
            "Cause": "Failed to deploy EC2 instance",
            "Error": "DeploymentFailedError"
        },
        "HandleStartDcvError": {
            "Type": "Fail",
            "Cause": "Failed to start DCV service on resumed instance",
            "Error": "StartDcvFailedError"
        }
    }
}
